architecture MyCPU {
            registers {
                16 { r0 r0 r2 r3 r4 r5 r6 r7 }
                32 { r8 r9 r10 r11 r12 r13 r14 r15 }
            }
            memory 1024
            format L {
                op opcode [1:0]
                rd reg_dest [4:2]
                rs1 reg_src [7:5]
                rs2 reg_src [10:7]
            }
            instruction add {
                opcode 1
                format RRR
                operands {
                    rd register output
                    rs1 register input
                    rs2 register input
                }
                behavior{
                    rd = rs1;
                }
            }
            instruction sub {
                opcode 2
                format RRR
                operands {
                    rd register output
                    rs1 register input
                    rs2 register input
                }
                behavior{
                    rd = rs1;
                }
            }
            instruction abc {
                opcode 3
                format RRR
                operands {
                    rd register output
                    rs1 register input
                    rs2 register input
                }
                behavior{
                    rd = rs1;
                }
            }
            instruction xyz {
                opcode 3
                format RRR
                operands {
                    rd register output
                    rs1 register input
                    rs2 register input
                }
                behavior{
                    rd = rs1;
                }
            }
        }
