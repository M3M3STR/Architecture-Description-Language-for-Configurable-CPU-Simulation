architecture MyCPU {
    registers {
        16 { r0 r1 r2 r3 r4 r5 r6 r7 }
        32 { r8 r9 r10 r11 r12 r13 r14 r15 }
    }
    memory 1024
    format RRR {
        opcode [1:0]
        reg_dest [4:2]
        reg_src [7:5]
        reg_src [10:8]
    }
    instruction add {
        opcode 1
        format RRR
    }
    instruction sub {
        opcode 2
        format RRR
    }
    instruction abc {
        opcode 1
        format RRR
    }
    instruction xyz {
        opcode 2
        format RRR
    }
}